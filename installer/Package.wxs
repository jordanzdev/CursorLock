<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user install into %LOCALAPPDATA%\Programs\CursorLock: no administrator rights needed.
  Minimal wizard: progress, then a final page with an "Open CursorLock" check box.
  Built once per culture (Strings.*.wxl). A running CursorLock is closed through the
  Restart Manager (the app exits on WM_ENDSESSION).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CursorLock"
           Manufacturer="jordanzdev"
           Version="$(var.ProductVersion)"
           Language="!(loc.ProductLanguage)"
           UpgradeCode="B57385A8-D567-4B38-BB70-29E16911A32F"
           Scope="perUser"
           Compressed="yes">

    <!--
      Replaces any installed CursorLock: older or same version (reinstalling the same MSI), and in
      any language (the English and Spanish MSIs upgrade each other).
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" IgnoreLanguage="yes" DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)..\assets\CursorLock.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="CursorLock" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Files under the user profile need an HKCU key path and explicit folder removal (ICE38, ICE64). -->
    <Component Id="AppExecutable" Directory="INSTALLFOLDER" Guid="BA4C8822-61F4-4E0B-BE36-B1D2709E4DC6">
      <File Id="CursorLockExe" Source="$(var.SourceExe)" KeyPath="no" />
      <RegistryValue Root="HKCU" Key="Software\CursorLock\Install" Name="Executable"
                     Type="string" Value="[#CursorLockExe]" KeyPath="yes" />
      <Shortcut Id="AppShortcut" Directory="ProgramMenuFolder" Name="CursorLock"
                Target="[#CursorLockExe]" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
    </Component>

    <Feature Id="Main">
      <ComponentRef Id="AppExecutable" />
    </Feature>

    <!-- Real uninstall only (not an upgrade): the app removes its startup entry and settings. -->
    <CustomAction Id="RemoveUserData" FileRef="CursorLockExe" ExeCommand="--uninstall"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!-- Starts the app without arguments, so it opens its Settings window. -->
    <CustomAction Id="LaunchApp" FileRef="CursorLockExe" ExeCommand="" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="RemoveUserData" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- Basic UI (msiexec /passive) has no final page to ask, so the app is opened directly. -->
      <Custom Action="LaunchApp" After="InstallFinalize"
              Condition="NOT Installed AND NOT REMOVE AND UILevel = 3" />
    </InstallExecuteSequence>

    <!-- Full UI: progress, then the final page with the "Open CursorLock" check box (checked). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.OpenApp)"
                 Before="CostFinalize" Sequence="ui" Condition="NOT Installed" />

    <UI Id="CursorLockUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />

    <!-- Generated by tools/New-Branding.ps1 -->
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)..\assets\installer-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)..\assets\installer-dialog.bmp" />
  </Package>
</Wix>
