<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user install into %LOCALAPPDATA%\Programs\CursorLock: no administrator rights needed.
  No wizard: Windows Installer shows its own progress bar in the system language.
  A running CursorLock is closed through the Restart Manager (the app exits on WM_ENDSESSION).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CursorLock"
           Manufacturer="jordanzdev"
           Version="$(var.ProductVersion)"
           UpgradeCode="B57385A8-D567-4B38-BB70-29E16911A32F"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of CursorLock is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)..\assets\CursorLock.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="CursorLock" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Files under the user profile need an HKCU key path and explicit folder removal (ICE38, ICE64). -->
    <Component Id="AppExecutable" Directory="INSTALLFOLDER" Guid="BA4C8822-61F4-4E0B-BE36-B1D2709E4DC6">
      <File Id="CursorLockExe" Source="$(var.SourceExe)" KeyPath="no" />
      <RegistryValue Root="HKCU" Key="Software\CursorLock\Install" Name="Executable"
                     Type="string" Value="[#CursorLockExe]" KeyPath="yes" />
      <Shortcut Id="AppShortcut" Directory="ProgramMenuFolder" Name="CursorLock"
                Target="[#CursorLockExe]" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
    </Component>

    <Feature Id="Main">
      <ComponentRef Id="AppExecutable" />
    </Feature>

    <!-- Real uninstall only (not an upgrade): the app removes its startup entry and settings. -->
    <CustomAction Id="RemoveUserData" FileRef="CursorLockExe" ExeCommand="--uninstall"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!-- After installing or upgrading with UI, start the app (it lives in the tray). -->
    <CustomAction Id="LaunchApp" FileRef="CursorLockExe" ExeCommand="" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="RemoveUserData" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchApp" After="InstallFinalize"
              Condition="NOT Installed AND NOT REMOVE AND UILevel &gt; 2" />
    </InstallExecuteSequence>
  </Package>
</Wix>
